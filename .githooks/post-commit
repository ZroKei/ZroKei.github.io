#!/bin/sh
# post-commit: 任何来源的提交（VS Code 源代码管理面板 / 命令行 / 脚本 / AI 工具）
# 都会自动推送到 GitHub。
# 与 auto_push.bat 互补：bat 负责 add + commit + push，本 hook 只负责 push。

GIT_DIR_PATH=$(git rev-parse --git-dir)
LOG="$GIT_DIR_PATH/auto-push.log"
FAILED="$GIT_DIR_PATH/../PUSH_FAILED.txt"

# 日志超过 256KB 就清空（与 auto_push.bat 的轮转策略一致）
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 262144 ]; then
  : > "$LOG"
fi

echo "[$(date '+%H:%M:%S')] post-commit -> push" >> "$LOG"

# 后台运行时没有终端，禁止 git 弹出凭据提示
export GIT_TERMINAL_PROMPT=0
PUSH_OPTS="-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=15"

if git $PUSH_OPTS push --quiet >> "$LOG" 2>&1; then
  rm -f "$FAILED"
  exit 0
fi

# 远端有新提交（例如在 github.com 网页上改过）：rebase 后重试一次
git pull --rebase --autostash --quiet >> "$LOG" 2>&1
if git $PUSH_OPTS push --quiet >> "$LOG" 2>&1; then
  rm -f "$FAILED"
else
  echo "push failed at $(date '+%Y-%m-%d %H:%M:%S') - see .git/auto-push.log" > "$FAILED"
fi

# post-commit 永远返回成功，避免影响提交本身
exit 0
