#!/bin/sh
# post-commit: 提交后自动推送。
#
# 两条硬约束（都是踩过的坑）：
# 1. 必须有时限。git commit 要等 hook 跑完才返回，这里一旦卡住，
#    VS Code 的"提交"按钮就会一直转圈。所有 git 命令都套 timeout。
# 2. 不能和 auto_push.bat 共用日志。bat 运行时会独占 .git/auto-push.log
#    （Windows 同一文件二次打开报 Device or resource busy），重定向失败
#    会导致整条命令不执行，推送被静默吞掉。所以这里用 .git/hook-push.log。
#
# 注意：Windows 下 `( ... ) &` 派生的子进程会随父进程退出被杀掉，
# 试过异步推送但活不下来，所以这里是同步 + 超时。

GIT_DIR_PATH=$(git rev-parse --git-dir)
LOG="$GIT_DIR_PATH/hook-push.log"
FAILED="$GIT_DIR_PATH/../PUSH_FAILED.txt"

# 日志超过 256KB 就清空
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 262144 ]; then
  : > "$LOG"
fi

echo "[$(date '+%H:%M:%S')] post-commit -> push" >> "$LOG"

# 后台运行时没有终端，禁止 git 弹出凭据提示
export GIT_TERMINAL_PROMPT=0
PUSH_OPTS="-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10"

# 先花约 0.5 秒探一下 443 通不通。不通就直接跳过，别让 commit 白等十几秒，
# 未推送的提交由 10 分钟一次的 auto_push.bat 兜底。
if ! timeout 2 bash -c 'exec 3<>/dev/tcp/github.com/443' 2>/dev/null; then
  echo "[$(date '+%H:%M:%S')] github:443 unreachable, skip push (auto_push.bat will retry)" >> "$LOG"
  exit 0
fi

# 12 秒上限：网络正常时小推送 1~3 秒；卡住就放弃，交给 10 分钟一次的定时任务
if timeout 12 git $PUSH_OPTS push --quiet >> "$LOG" 2>&1; then
  rm -f "$FAILED"
  exit 0
fi

# 这里故意不做 rebase：远端分叉的兜底由 auto_push.bat 负责，
# 避免 hook 偷偷改写工作区，打断正在编辑的文件。
echo "[$(date '+%H:%M:%S')] push failed (timeout or rejected), left for auto_push.bat" >> "$LOG"
echo "push failed at $(date '+%Y-%m-%d %H:%M:%S') - see .git/hook-push.log" > "$FAILED"

exit 0
